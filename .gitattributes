# Normalize line endings in the repository.
# Kavya deploys to Linux/VPS, so LF is the canonical in-repo form.
# Windows-only shell scripts keep CRLF.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending translated.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary

# Lockfiles are generated; keep them diff-stable.
package-lock.json text eol=lf -diff
