node_modules/

# App dependencies/build output
apps/**/node_modules/
apps/dashboard/dist/
apps/dashboard/vite.config.js
apps/dashboard/vite.config.d.ts

# Local env files. Edit only the root .env locally.
.env
apps/bot/.env
apps/bot/.auth/
apps/bot/database/*.json
runtime/
apps/dashboard/runtime/
release/

# Per-run local test runtime directories. These contain live Baileys WhatsApp
# session credentials (baileys-auth/) and a full production kavya-db.json with
# customer data. They must never be committed.
runtime-*/
apps/*/runtime-*/

# Local browser automation profiles. Contain bookmarks and cookies.
artifacts/chrome-mobile-profile*/
artifacts/**/chrome-mobile-profile*/

# Database snapshots and repair backups. These are copies of the production
# kavya-db.json and contain customer credentials, order records and PINs.
artifacts/**/kavya-db*.json
artifacts/**/kavya-db*/
# Backup snapshots of list/rental data. These are copies of files that already
# live in `database/` and `apps/*/database/`; the snapshot in artifacts/ is not
# the source of truth, so tracking it only widens the blast radius if a phone
# number or rental record has to be purged from history.
artifacts/**/*list*.json
artifacts/**/rentals.json
artifacts/**/sewa.json
test-results/
tmp/
outputs/
_zip_inspect/
kavya-pterodactyl-linux-latest.tar.gz
*.tgz
*.tar.gz
*.log
smoke-*.log
reports/stock-id-backfill-*

# Transpiled TypeScript emitted by the server test suite at run time. The suite
# removes it on exit, but a hard crash mid-run would leave it untracked.
apps/dashboard/server/.compiled-tests/

# OS/editor noise
.DS_Store
*.tsbuildinfo

# VS Code
.vscode/

# Windows
Thumbs.db

# Keep example env
!.env.example
