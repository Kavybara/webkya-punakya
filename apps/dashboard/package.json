{
  "name": "kavya-digital-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "api": "node server/index.js",
    "start": "node server/index.js",
    "sheets:backfill": "node server/scripts/backfill-google-sheets.js",
