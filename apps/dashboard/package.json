{
  "name": "kavya-digital-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "api": "node server/index.js",
    "start": "node server/index.js",
    "sheets:backfill": "node server/scripts/backfill-google-sheets.js",
    "sheets:audit": "node server/scripts/audit-sheet-order-rows.js",
    "sheets:history:backfill": "node server/scripts/backfill-order-history.js",
    "sheets:stock-id:backfill": "node server/scripts/stock-id-backfill.js",
    "sheets:manual-order-id:backfill": "node server/scripts/manual-order-id-backfill.js",
    "reseller-account:check": "node server/scripts/reseller-account-visibility-check.js",
    "whatsapp:check": "node server/scripts/whatsapp-check.js",
    "web-order:check": "node server/scripts/web-order-check.js",
    "web:typecheck": "tsc -b",
    "lint": "eslint src",
    "web:build": "vite build",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:security": "node --test server/tests/security.test.mjs",
    "test:routes": "node --test server/tests/route-modules.test.mjs",
    "test:ui": "node --test server/tests/owner-console-ui.test.mjs server/tests/reseller-panel-v2-ui.test.mjs",
    "test:all": "node --test server/tests/",
    "test:sheets-template": "node --test server/tests/google-sheets-template.test.mjs",
    "test:order-stock": "node --test server/tests/order-stock-service.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "framer-motion": "12.40.0",
    "lucide-react": "1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.18.1",
    "recharts": "3.8.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "postcss": "8.5.23",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8"
  }
}
