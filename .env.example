# Kavya VPS/Linux environment.
# Isi secret integrasi utama lewat Dashboard > Settings > API & Integrasi.
# File .env asli tidak dimasukkan ke zip deploy.

SERVER_PORT=1912
PORT=1912
DASHBOARD_API_PORT=4174
PUBLIC_DOMAIN=https://vya.baby
AUTH_SECRET=replace-with-long-random-secret
OWNER_WHATSAPP_NUMBER=628xxxxxxxxxx
OWNER_PASSWORD=
BACKUP_OWNER_NUMBER=628xxxxxxxxxx
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-long-backup-passphrase

WHATSAPP_PORT=4016
WHATSAPP_BOT_URL=http://127.0.0.1:4016

RUNTIME_DIR=apps/dashboard/runtime
RUNTIME_TMP_DIR=apps/dashboard/runtime/tmp
RUNTIME_BACKUP_DIR=apps/dashboard/runtime/backups
BAILEYS_AUTH_DIR=apps/dashboard/runtime/baileys-auth
WHATSAPP_DATABASE_DIR=apps/dashboard/runtime/whatsapp-database
RUNTIME_BACKUP_KEEP=1

PAYMENT_TTL_MINUTES=4
PAKASIR_TIMEOUT_MS=20000
PAKASIR_RETRIES=1
PAKASIR_RETRY_DELAY_MS=750
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
REGISTRATION_OTP_TTL_MS=600000
REGISTRATION_OTP_RESEND_MS=60000
REGISTRATION_OTP_WINDOW_MS=3600000
REGISTRATION_OTP_MAX_REQUESTS=5
REGISTRATION_OTP_MAX_ATTEMPTS=5
RESELLER_VIEW_SHEETS_MAX_AGE_MS=60000
SESSION_TTL_SECONDS=28800
SESSION_REMEMBER_TTL_SECONDS=2592000

GMAIL_MODE=imap
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
GMAIL_IMAP_SECURE=true

AUTO_INSTALL_ON_START=true
AUTO_BUILD_ON_START=true
AUTO_IMPORT_LEGACY_ON_START=true
AUTO_IMPORT_LEGACY_FORCE_ON_START=false
REQUIRE_LEGACY_IMPORT_ON_START=false
AUTO_BACKUP=true
AUTO_BACKUP_SCHEDULE_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_DELETE_AFTER_SEND=true
AUTO_BACKUP_ON_START=false
AUTO_BACKUP_ON_CONNECT=false
AUTO_BACKUP_ON_RECONNECT=false
BACKUP_WHATSAPP_WAIT_MS=120000
WHATSAPP_BOT_TIMEOUT_MS=120000
WHATSAPP_SEND_TIMEOUT_MS=90000
WHATSAPP_COMMAND_SEND_TIMEOUT_MS=120000
WHATSAPP_COMMAND_SEND_RETRIES=0
WHATSAPP_STABLE_CONNECT_DELAY_MS=90000
WHATSAPP_GROUP_SYNC_ON_CONNECT=false
WHATSAPP_OWNER_STABLE_NOTIFY=true
WHATSAPP_OWNER_STABLE_NOTIFY_COOLDOWN_MS=1800000
OPERATIONAL_ALERT_FAILURE_THRESHOLD=3
OPERATIONAL_ALERT_COOLDOWN_MS=43200000

# Optional. Sumber utama Cloudflare Tunnel. Saat start, nilai ini disinkron ke runtime dashboard.
CLOUDFLARED_PROTOCOL=http2
CLOUDFLARED_LOG_LEVEL=error
CLOUDFLARED_TOKEN=
