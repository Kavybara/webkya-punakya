# Kavya Pterodactyl minimal env.
# Isi secret integrasi utama lewat Dashboard > Settings > API & Integrasi.
# File .env asli tidak dimasukkan ke zip deploy.

SERVER_PORT=1912
PORT=1912
DASHBOARD_API_PORT=4174
PUBLIC_DOMAIN=https://vya.baby
AUTH_SECRET=replace-with-long-random-secret
OWNER_WHATSAPP_NUMBER=628xxxxxxxxxx
OWNER_PASSWORD=
BACKUP_OWNER_NUMBER=628xxxxxxxxxx

WHATSAPP_PORT=4016
WHATSAPP_BOT_URL=http://127.0.0.1:4016

RUNTIME_DIR=kavya-digital-dashboard/runtime
RUNTIME_TMP_DIR=kavya-digital-dashboard/runtime/tmp
RUNTIME_BACKUP_DIR=kavya-digital-dashboard/runtime/backups
BAILEYS_AUTH_DIR=kavya-digital-dashboard/runtime/baileys-auth
WHATSAPP_DATABASE_DIR=kavya-digital-dashboard/runtime/whatsapp-database
RUNTIME_BACKUP_KEEP=30

PAYMENT_TTL_MINUTES=4
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
SESSION_TTL_SECONDS=28800
SESSION_REMEMBER_TTL_SECONDS=2592000

GMAIL_MODE=imap
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
GMAIL_IMAP_SECURE=true

AUTO_INSTALL_ON_START=true
AUTO_BUILD_ON_START=true
AUTO_IMPORT_LEGACY_ON_START=true
AUTO_IMPORT_LEGACY_FORCE_ON_START=false
REQUIRE_LEGACY_IMPORT_ON_START=false
AUTO_BACKUP=true
AUTO_BACKUP_SCHEDULE_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=6
AUTO_BACKUP_ON_START=false
BACKUP_WHATSAPP_WAIT_MS=120000

# Optional. Sumber utama Cloudflare Tunnel. Saat start, nilai ini disinkron ke runtime dashboard.
CLOUDFLARED_TOKEN=
