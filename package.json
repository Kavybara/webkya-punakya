{
  "name": "kavya-pterodactyl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kavya dashboard and WhatsApp service launcher for Pterodactyl.",
  "scripts": {
    "start": "node ./pterodactyl/startup/ptero-start.mjs",
    "ptero:start": "node ./pterodactyl/startup/ptero-start.mjs",
    "ptero:build": "npm run dashboard:build",
    "dashboard:install": "npm install --prefix apps/dashboard",
    "dashboard:dev": "npm run dev --prefix apps/dashboard",
    "dashboard:build": "npm run web:build --prefix apps/dashboard",
    "dashboard:start": "npm run start --prefix apps/dashboard",
    "dashboard:typecheck": "npm run web:typecheck --prefix apps/dashboard",
    "web:install": "npm run dashboard:install",
    "web:dev": "npm run dashboard:dev",
    "web:build": "npm run dashboard:build",
    "web:start": "npm run dashboard:start",
    "web:typecheck": "npm run dashboard:typecheck",
    "whatsapp:install": "npm install --prefix apps/bot",
    "whatsapp:start": "npm run start --prefix apps/bot",
    "whatsapp:check": "npm run check --prefix apps/bot",
    "backup:audit": "node ./scripts/deploy/import-legacy-wa-backup.mjs --dry-run",
    "wa:import-backup": "node ./scripts/deploy/import-legacy-wa-backup.mjs",
    "whatsapp:repair-auth": "node ./scripts/maintenance/repair-whatsapp-auth.mjs",
    "runtime:backup": "node ./scripts/maintenance/runtime-backup.mjs",
    "runtime:backup:send": "node ./scripts/maintenance/runtime-backup.mjs --send-whatsapp",
    "runtime:cleanup": "node ./scripts/maintenance/cleanup-runtime.mjs",
    "dashboard:data-cleanup": "node ./scripts/maintenance/dashboard-data-cleanup.mjs",
    "dashboard:data-cleanup:apply": "node ./scripts/maintenance/dashboard-data-cleanup.mjs --apply"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hapi/boom": "^10.0.1",
    "api-autoresbot": "^1.0.6",
    "archiver": "^7.0.1",
    "axios": "^1.16.0",
    "baileys": "^7.0.0-rc.9",
    "btch-downloader": "^2.8.2",
    "chalk": "^5.6.2",
    "cheerio": "^1.1.2",
    "cloudflared": "^0.7.1",
    "date-fns": "^4.1.0",
    "fast-levenshtein": "^3.0.0",
    "file-type": "^16.5.3",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.3.0",
    "imapflow": "^1.3.5",
    "jimp": "^1.6.0",
    "moment-timezone": "^0.5.46",
    "node-fetch": "^2.7.0",
    "node-webpmux": "^3.2.0",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.7.2",
    "sharp": "0.33.4",
    "unzipper": "^0.12.3",
    "uuid": "^11.1.0",
    "wa-sticker-formatter": "^4.4.4",
    "whois": "^2.14.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yt-search": "^2.12.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
